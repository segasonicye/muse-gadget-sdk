# Alientek ATK-DNESP32S3-BOX0 (ESP32-S3 QFN56 rev v0.2): 16 MB quad flash
# (esptool: vendor 0x68, device 0x4018, 3.3 V), 8 MB embedded octal PSRAM
# (AP_3v3), native USB Serial/JTAG. Full Muse build, like the Xingzhi Cube:
# pairing, push-to-talk, captions and LAN TTS spoken replies.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_ATK_BOX0=y
CONFIG_HOMEHUB_BUTTON_GPIO=0
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_PM_PROFILING=y
CONFIG_MUSE_TTS_URL="http://192.168.31.240:18765/tts"
CONFIG_MUSE_CJK_FONT=y
